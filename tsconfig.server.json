{
  "compilerOptions": {
    /* Language and module */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* Output and root directories */
    "outDir": "./dist/server",
    "rootDir": ".", // Changed to project root to include shared/ and vite.config.ts
    "baseUrl": ".", // Keep baseUrl at project root
    "paths": {
      "@shared/*": ["shared/*"] // Relative to baseUrl
    },

    /* Interop */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Type checking */
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* Output settings */
    "target": "ESNext",
    "sourceMap": true
  },
  "include": [
    "server/**/*.ts", // Server files
    "shared/**/*.ts" // Shared files
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src",
    "client", // Exclude client directory
    "vite.config.ts" // Exclude vite.config.ts from server build
  ]
}