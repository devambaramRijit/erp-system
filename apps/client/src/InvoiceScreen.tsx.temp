// Add custom styles for the product dropdown
const productDropdownStyles = `
  /* Product dropdown in Add/Edit Item modal */
  .ant-modal .ant-select-dropdown {
    min-width: 550px !important;
    max-width: 650px !important;
  }

  .ant-modal .ant-select-item {
    height: auto !important;
    min-height: 100px !important;
    padding: 12px 15px !important;
    line-height: 1.5 !important;
    white-space: normal !important;
  }

  .ant-modal .ant-select-item-option-content {
    padding: 6px 0 !important;
  }

  .ant-modal .ant-select-item-option-content div {
    margin-bottom: 4px !important;
  }

  /* Ensure dropdown appears above modal */
  .ant-modal .ant-select-dropdown {
    z-index: 1050 !important;
  }

  /* Fix for the selected item display - show only product name */
  .ant-modal .ant-select-selection-item {
    height: auto !important;
    min-height: 32px !important;
    padding: 4px 8px !important;
    line-height: 1.4 !important;
    white-space: nowrap !important;
    text-overflow: ellipsis !important;
    overflow: hidden !important;
  }
`;

// Create style element and append to head
const styleElement = document.createElement('style');
styleElement.innerHTML = productDropdownStyles;
document.head.appendChild(styleElement);

const { Option } = Select;
const { TextArea } = Input;

interface Product {
  id: string;
  sku: string;
  name: string;
  size?: string;
  unit?: string;
  quantity: number;
  price: number;
  productType: string;
  category?: string;
  ratePerPiece?: number;
  ratePerInch?: number;
  costPricePerInch?: number;
  costPricePerPiece?: number;
}

// Define the structure of an invoice item
interface InvoiceItem {
  id: string;
  productId: string;
  name: string;
  unit: string;
  quantity: number;
  price: number;
  total: number;
  productCategory?: string;
  ratePerInch?: number;
  size?: number;
  cpPerPc?: number;
  rate?: number;
  pricePerInch?: number;
}

interface Invoice {
  id: string;
  invoiceNumber: string;
  date: string;
  customerName: string;
  customerEmail: string;
  billingAddress: string;
  invoiceType: 'manufactured';
  items: InvoiceItem[];
  subtotal: number;
  discountRate: number;
  discountAmount: number;
  advancePayment: number;
  shippingCharges: number;
  packingCharges: number;
  total: number;
  notes?: string;
  notesLine1?: string;
  notesLine2?: string;
  notesLine3?: string;
  isFinalized?: boolean;
  discountType?: 'percentage' | 'decimal';
}

// Helper function to ensure invoice items are always an array
const parseInvoiceItems = (invoice: any): Invoice => {
  if (typeof invoice.items === 'string') {
    try {
      return { ...invoice, items: JSON.parse(invoice.items) };
    } catch (e) {
      console.error('Failed to parse items for invoice:', invoice.invoiceNumber, e);
      return { ...invoice, items: [] }; // Return with empty items on parse error
    }
  }
  // Ensure items is always an array, even if it's null or undefined
  if (!Array.isArray(invoice.items)) {
    invoice.items = [];
  }
  return invoice;
};

const InvoiceScreen: React.FC = () => {
  const [form] = Form.useForm();
  const [itemForm] = Form.useForm();
  const [customerForm] = Form.useForm();
  const [invoices, setInvoices] = useState<Invoice[]>([]);
  const [customers, setCustomers] = useState<CustomerData[]>([]);
  const [products, setProducts] = useState<Product[]>([]);
  const [productTypes, setProductTypes] = useState<string[]>(() => {
    const savedProductTypes = localStorage.getItem('inventoryProductTypes');
    return savedProductTypes ? JSON.parse(savedProductTypes) : [];
  });

  // Load products from localStorage
  useEffect(() => {
    const loadProducts = () => {
      try {
        const items = localStorageService.getItems('inventory');
        const transformedProducts = items.map((item: any) => ({
          id: item.id,
          sku: item.code || '',
          name: item.name || '',
          quantity: Number(item.quantity) || 0,
          price: item.ratePerPiece || 0,
          productType: 'Traded',
          category: item.category || '',
          ratePerPiece: item.ratePerPiece,
          ratePerInch: item.ratePerInch,
          costPricePerInch: item.costPricePerInch,
          costPricePerPiece: item.costPricePerPiece,
        }));
        setProducts(transformedProducts);
      } catch (err) {
        console.error('Failed to load products:', err);
        setProducts([]);
      }
    };

    loadProducts();
  }, []);




  const [discountType, setDiscountType] = useState<'percentage' | 'decimal'>('percentage');
  const [visible, setVisible] = useState(false);
  const [itemVisible, setItemVisible] = useState(false);
  const [customerModalVisible, setCustomerModalVisible] = useState(false);
  const [editingInvoice, setEditingInvoice] = useState<Invoice | null>(null);
  const [currentInvoice, setCurrentInvoice] = useState<Invoice | null>(null);

  // Ensure items are properly parsed when editing an invoice
  React.useEffect(() => {
    if (editingInvoice && editingInvoice.items) {
      if (typeof editingInvoice.items === 'string') {
        try {
          const parsedItems = JSON.parse(editingInvoice.items);
          setEditingInvoice({
            ...editingInvoice,
            items: parsedItems
          });
        } catch (e) {
          console.error('Error parsing items in editingInvoice useEffect:', e);
        }
      }
    }
  }, [editingInvoice?.id]);
  const [customerSearchTerm, setCustomerSearchTerm] = useState('');

  // Ensure items are properly parsed when currentInvoice changes
  React.useEffect(() => {
    if (currentInvoice && currentInvoice.items) {
      if (typeof currentInvoice.items === 'string') {
        try {
          const parsedItems = JSON.parse(currentInvoice.items);
          setCurrentInvoice({
            ...currentInvoice,
            items: parsedItems
          });
        } catch (e) {
          console.error('Error parsing items in useEffect:', e);
        }
      }
    }
  }, [currentInvoice?.id]);

  const [selectedCustomer, setSelectedCustomer] = useState<CustomerData | null>(null);
  const [showAddProductModal, setShowAddProductModal] = useState(false);
  const [showRateField, setShowRateField] = useState(false);
  const [disableRateField, setDisableRateField] = useState(false);
  const [disablePriceFields, setDisablePriceFields] = useState(false);
  const [selectedProductCategory, setSelectedProductCategory] = useState<string | undefined>('');
  const [showActionLogModal, setShowActionLogModal] = useState(false);
  const [actionLog, setActionLog] = useState<any[]>([]);
  const [selectedInvoiceId, setSelectedInvoiceId] = useState<string | null>(null);
  const [selectedCustomerId, setSelectedCustomerId] = useState<string | null>(null);
  const [editingItem, setEditingItem] = useState<InvoiceItem | null>(null);
  const [showEditItemModal, setShowEditItemModal] = useState(false);

  // Load invoices from localStorage on component mount
  useEffect(() => {
    const loadInvoices = async () => {
      try {
        const invoiceData = localStorageService.getItems('invoices');
        const parsedInvoices = invoiceData.map((inv: any) => {
          // Ensure items is always an array
          const items = typeof inv.items === 'string' ? JSON.parse(inv.items) : inv.items || [];
          return {
            ...inv,
            items,
            date: inv.date || new Date().toISOString().split('T')[0],
            invoiceType: inv.invoiceType || 'manufactured',
            customerName: inv.customerName || inv.customer?.customerName || '',
            customerEmail: inv.customerEmail || inv.customer?.mobileNumber1 || '',
            billingAddress: inv.billingAddress || inv.customer?.billingAddress || '',
            subtotal: inv.subtotal || 0,
            discountRate: inv.discountRate || 0,
            discountAmount: inv.discountAmount || 0,
            advancePayment: inv.advancePayment || 0,
            shippingCharges: inv.shippingCharges || 0,
            packingCharges: inv.packingCharges || 0,
            total: inv.total || 0,
            discountType: inv.discountType || 'percentage'
          };
        });
        setInvoices(parsedInvoices);
      } catch (error) {
        console.error('Failed to load invoices:', error);
        setInvoices([]);
      }
    };

    loadInvoices();
  }, []);

  // Load customers from localStorage on component mount
  useEffect(() => {
    const loadCustomers = async () => {
      try {
        const customerData = localStorageService.getItems('customers');
        const parsedCustomers = customerData.map((customer: any) => ({
          ...customer,
          customerName: customer.customerName || customer.name || '',
          mobileNumber1: customer.mobileNumber1 || customer.phone || '',
          mobileNumber2: customer.mobileNumber2 || '',
          billingAddress: customer.billingAddress || customer.address || '',
          houseNumber: customer.houseNumber || '',
          city: customer.city || '',
          district: customer.district || '',
          state: customer.state || '',
          pinCode: customer.pinCode || '',
          landmark: customer.landmark || '',
          source: customer.source || '',
        }));
        setCustomers(parsedCustomers);
      } catch (error) {
        console.error('Failed to load customers:', error);
        setCustomers([]);
      }
    };

    loadCustomers();
  }, []);

  const handleProductSelect = (productId: string) => {
    const product = products.find(p => p.id === productId);
    if (product) {
      const ratePerPiece = product.price || 0;
      itemForm.setFieldsValue({
        rate: ratePerPiece
      });
      setDisablePriceFields(true);
      setShowRateField(true);
      setDisableRateField(false); // Allow editing rate field
    }
  };

  const handleSaveItem = () => {
    itemForm
      .validateFields()
      .then(values => {
        if (currentInvoice) {
          const product = products.find(p => p.id === values.productId);
          if (product) {
            let newItem: InvoiceItem;

            if (currentInvoice.invoiceType === 'manufactured') {
              const ratePerInch = values.ratePerInch || 0;
              const size = values.size || 0;
              // Use the rate value from the form field, which should already be calculated
              const rate = values.rate || (ratePerInch * size);
              const cpPerPc = rate;
              const total = rate * values.quantity;
              console.log('Saving item:', { ratePerInch, size, rate, cpPerPc, total, formRate: values.rate });

              newItem = {
                id: Date.now().toString(),
                productId: values.productId,
                name: product.sku, // Changed from name to sku
                unit: values.unit || product.unit || 'pcs',
                quantity: values.quantity,
                price: rate,
                total: total,
                productCategory: product.category || '',
                ratePerInch: ratePerInch,
                size: size,
                cpPerPc: cpPerPc,
                rate: rate,
              };
            } else {
              const rate = values.rate || product.price || 1; // Default to 1 if both are undefined or 0
              const ratePerInch = values.ratePerInch || 1; // Default to 1 for traded products
              const size = values.size || 1; // Default to 1 for traded products
              newItem = {
                id: Date.now().toString(),
                productId: values.productId,
                name: product.sku, // Changed from name to sku
                unit: values.unit || product.unit || 'pcs',
                quantity: values.quantity,
                price: rate,
                total: rate * values.quantity * size * ratePerInch,
                productCategory: product.category || '',
                rate: rate,
                ratePerInch: ratePerInch,
                size: size,
              };
            }

            const updatedItems = [...(Array.isArray(currentInvoice.items) ? currentInvoice.items : []), newItem];
            console.log('Updated items:', JSON.stringify(updatedItems));
            console.log('New item:', JSON.stringify(newItem));
            console.log('New item rate:', newItem.rate);
            const subtotal = updatedItems.reduce((sum, item) => sum + item.total, 0);
            const subtotalAfterAdvance = subtotal - (currentInvoice.advancePayment || 0);
            let discountAmount;

            if (discountType === 'percentage') {
              // Calculate discount as percentage of subtotal
              discountAmount = (subtotal * currentInvoice.discountRate) / 100;
            } else {
              // Use discount as fixed decimal amount
              discountAmount = currentInvoice.discountRate;
            }
            const subtotalAfterDiscount = subtotal - discountAmount;
            const subtotalAfterAdvanceFinal = subtotalAfterDiscount - (currentInvoice.advancePayment || 0);
            const total = subtotalAfterAdvanceFinal + currentInvoice.shippingCharges + currentInvoice.packingCharges;

            const updatedInvoice = {
              ...currentInvoice,
              items: updatedItems,
              subtotal,
              discountAmount,
              total,
            };
            setCurrentInvoice(updatedInvoice);
            localStorage.setItem('currentInvoice', JSON.stringify(updatedInvoice));

            setItemVisible(false);
          }
        }
      })
      .catch(info => {
        console.log('Validate Failed:', info);
      });
  };

  const handleDeleteItem = (id: string) => {
    if (currentInvoice) {
      const updatedItems = (Array.isArray(currentInvoice.items) ? currentInvoice.items : []).filter(item => item.id !== id);
      const subtotal = updatedItems.reduce((sum, item) => sum + item.total, 0);
      const subtotalAfterAdvance = subtotal - (currentInvoice.advancePayment || 0);
      let discountAmount;

      if (discountType === 'percentage') {
        // Calculate discount as percentage of subtotal
        discountAmount = (subtotal * currentInvoice.discountRate) / 100;
      } else {
        // Use discount as fixed decimal amount
        discountAmount = currentInvoice.discountRate;
      }
      const subtotalAfterDiscount = subtotal - discountAmount;
      const subtotalAfterAdvanceFinal = subtotalAfterDiscount - (currentInvoice.advancePayment || 0);
      const total = subtotalAfterAdvanceFinal + currentInvoice.shippingCharges + currentInvoice.packingCharges;

      const updatedInvoice = {
        ...currentInvoice,
        items: updatedItems,
        subtotal,
        discountAmount,
        total,
      };
      setCurrentInvoice(updatedInvoice);
      localStorage.setItem('currentInvoice', JSON.stringify(updatedInvoice));
    }
  };

  const handleEditItem = (record: InvoiceItem) => {
    setEditingItem(record);
    setShowEditItemModal(true);
    // Pre-fill the form with the item data
    itemForm.setFieldsValue({
      productId: record.productId,
      quantity: record.quantity,
      rate: record.rate,
      ratePerInch: record.ratePerInch,
      size: record.size,
      unit: record.unit,
    });
  };

  const handleUpdateItem = () => {
    itemForm.validateFields().then(values => {
      if (currentInvoice && editingItem) {
        const product = products.find(p => p.id === values.productId);
        if (product) {
          let updatedItem: InvoiceItem;

          if (currentInvoice.invoiceType === 'manufactured') {
            const ratePerInch = values.ratePerInch || 0;
            const size = values.size || 0;
            const rate = values.rate || (ratePerInch * size);
            const total = rate * values.quantity;

            updatedItem = {
              ...editingItem,
              productId: values.productId,
              name: product.sku,
              unit: values.unit || product.unit || 'pcs',
              quantity: values.quantity,
              price: rate,
              total: total,
              productCategory: product.category || '',
              ratePerInch: ratePerInch,
              size: size,
              rate: rate,
            };
          } else {
            const rate = values.rate || product.price || 1;
            const ratePerInch = values.ratePerInch || 1;
            const size = values.size || 1;
            const total = rate * values.quantity * size * ratePerInch;

            updatedItem = {
              ...editingItem,
              productId: values.productId,
              name: product.sku,
              unit: values.unit || product.unit || 'pcs',
              quantity: values.quantity,
              price: rate,
              total: total,
              productCategory: product.category || '',
              rate: rate,
              ratePerInch: ratePerInch,
              size: size,
            };
          }

          const updatedItems = (Array.isArray(currentInvoice.items) ? currentInvoice.items : []).map(item =>
            item.id === editingItem.id ? updatedItem : item
          );

          const subtotal = updatedItems.reduce((sum, item) => sum + item.total, 0);
          const subtotalAfterAdvance = subtotal - (currentInvoice.advancePayment || 0);
          let discountAmount;

          if (discountType === 'percentage') {
            discountAmount = (subtotal * currentInvoice.discountRate) / 100;
          } else {
            discountAmount = currentInvoice.discountRate;
          }
          const subtotalAfterDiscount = subtotal - discountAmount;
          const subtotalAfterAdvanceFinal = subtotalAfterDiscount - (currentInvoice.advancePayment || 0);
          const total = subtotalAfterAdvanceFinal + currentInvoice.shippingCharges + currentInvoice.packingCharges;

          const updatedInvoice = {
            ...currentInvoice,
            items: updatedItems,
            subtotal,
            discountAmount,
            total,
          };
          setCurrentInvoice(updatedInvoice);
          localStorage.setItem('currentInvoice', JSON.stringify(updatedInvoice));
          setShowEditItemModal(false);
          setEditingItem(null);
          itemForm.resetFields();
        }
      }
    });
  };

  const handleProductCategoryChange = (category: string) => {
    setSelectedProductCategory(category);
    // Reset form fields when category changes
    itemForm.setFieldsValue({
      rate: undefined,
      ratePerInch: undefined,
      size: undefined,
    });
    setDisablePriceFields(false);
    setDisableRateField(false);
    setShowRateField(false);
  };

  const handleCustomerSelect = (customerId: string) => {
    const customer = customers.find(c => c.id === customerId);
    if (customer) {
      setSelectedCustomer(customer);
      form.setFieldsValue({
        customerName: customer.customerName || customer.name,
        customerEmail: customer.mobileNumber1 || customer.phone,
        billingAddress: customer.billingAddress || customer.address,
      });
    }
  };

  const handleAddCustomer = (values: any) => {
    const newCustomer: CustomerData = {
      id: Date.now().toString(),
      customerName: values.customerName,
      mobileNumber1: values.customerEmail,
      billingAddress: values.billingAddress,
      houseNumber: '',
      city: '',
      district: '',
      state: '',
      pinCode: '',
      landmark: '',
      source: '',
    };

    setCustomers([...customers, newCustomer]);
    setSelectedCustomer(newCustomer);
    message.success('New customer saved successfully!');
  }.catch(error => {
    console.log('Validation error:', error);
    message.error('Please fill in all required customer fields');
  });

  const getManufacturedColumns = () => {
    // Base columns that always show
    const columns = [
      {
        title: 'Product SKU',
        dataIndex: 'name',
        key: 'name',
      },
      {
        title: 'Product Category',
        dataIndex: 'productCategory',
        key: 'productCategory',
        render: (category: string) => category || 'General',
      },
    ];

    // Check if there are any Laddu Gopal Base, RK Base or Mata Rani Base products in the current invoice
    const hasSpecialProducts = (Array.isArray(currentInvoice?.items) ? currentInvoice.items : []).some(item =>
      item.productCategory === 'Laddu Gopal Base' ||
      item.productCategory === 'RK Base' ||
      item.productCategory === 'Mata Rani Base'
    );

    // Only add Price Per Inch and Size columns if there are special products
    if (hasSpecialProducts) {
      // Add Price Per Inch and Size columns with conditional content
      const ratePerInchColumn = {
        title: 'Rate Per Inch',
        dataIndex: 'ratePerInch',
        key: 'ratePerInch',
        render: (price: number, record: InvoiceItem) => {
          // Show rate per inch for all manufactured products
          return price ? `₹${price.toFixed(2)}` : '0.00';
        },
      };

      const sizeColumn = {
        title: 'Size',
        dataIndex: 'size',
        key: 'size',
        render: (size: string | number) => {
          // Show size value only if it exists and is not empty
          // Show size for all products
          return size && size.toString().trim() !== '' ? size : '';
        },
      };

      // Add conditional columns
      columns.push(ratePerInchColumn);
      columns.push(sizeColumn);
    }

    // Continue with the rest of the columns
    if (!hasSpecialProducts) {
    columns.push(
      {
        title: 'Rate/Pc',
        dataIndex: 'rate',
        key: 'rate',
        render: (rate: number, record: InvoiceItem) => {
          // For base products, calculate rate as pricePerInch * size
          // Show size for all products

          if (record.productCategory && record.productCategory.includes('Base')) {
            return ''; // Return empty string for Base products
          }
          // For other products, use the rate value directly
          return `₹${rate ? rate.toFixed(2) : '0.00'}`;
        },
      } as any,
      {
        title: 'Quantity',
        dataIndex: 'quantity',
        key: 'quantity',
      },
      {
        title: 'Unit',
        dataIndex: 'unit',
        key: 'unit',
        render: (unit: string) => unit || 'pcs',
      } as any,
      {
        title: 'Total',
        dataIndex: 'total',
        key: 'total',
        render: (total: number, record: InvoiceItem) => {
          // For base products, calculate total as (pricePerInch * size) * quantity
          // Show size for all products
          if (record.productCategory === 'Laddu Gopal Base' ||
              record.productCategory === 'RK Base' ||
              record.productCategory === 'Mata Rani Base' ||
              record.productCategory === 'Ganesh Lakshmi Base' ||
              record.productCategory === 'Shyam Baba Base') {
            const cpPerPc = (record.pricePerInch || 0) * (record.size || 0);
            const calculated = cpPerPc * (record.quantity || 0);
            return `₹${calculated.toFixed(2)}`;
          }
          // For other products, calculate total as rate * quantity
          const calculated = (record.rate || 0) * (record.quantity || 0);
          return `₹${calculated.toFixed(2)}`;
        },
      } as any
    );
    }
    return columns;
  };

  // Action column for both invoice types
  const actionColumn = {
    title: 'Action',
    key: 'action',
    render: (text: string, record: InvoiceItem) => (
      <Space>
        <Button
          type="primary"
          icon={<EditOutlined />}
          size="small"
          onClick={() => handleEditItem(record)}
        >
          Edit
        </Button>
        <Popconfirm
          title="Are you sure you want to delete this item?"
          onConfirm={() => handleDeleteItem(record.id)}
          okText="Yes"
          cancelText="No"
        >
          <Button type="primary" danger icon={<DeleteOutlined />} size="small">
            Delete
          </Button>
        </Popconfirm>
      </Space>
    ),
  };

  const getTradedColumns = () => {
    // Base columns that always show
    const columns = [
      {
        title: 'Product SKU',
        dataIndex: 'name',
        key: 'name',
      },
      {
        title: 'Product Category',
        dataIndex: 'productCategory',
        key: 'productCategory',
        render: (category: string) => category || 'General',
      },
    ];

    // Check if there are any base products in the current invoice
    let items = [];
    if (typeof currentInvoice?.items === 'string') {
      try {
        items = JSON.parse(currentInvoice.items);
      } catch (e) {
        console.error('Error parsing items:', e);
        items = [];
      }
    } else if (Array.isArray(currentInvoice?.items)) {
      items = currentInvoice.items;
    } else {
      items = [];
    }

    const hasSpecialProducts = items.some(item =>
      item.productCategory === 'Laddu Gopal Base' ||
      item.productCategory === 'RK Base' ||
      item.productCategory === 'Mata Rani Base'
    );

    // Always add Size column for all products
      // Add Size column with conditional content
      const sizeColumn = {
        title: 'Size',
        dataIndex: 'size',
        key: 'size',
        render: (size: string | number) => {
          // Show size value only if it exists and is not empty
          // Show size for all products



            return size && size.toString().trim() !== '' ? size : '';
        },
      };

      // Add the size column
      columns.push(sizeColumn);

    // Continue with the rest of the columns
    columns.push({
      title: 'Price',
      dataIndex: 'price',
      key: 'price',
      render: (price: number) => `₹${price ? price.toFixed(2) : '0.00'}`,
    } as any);
    columns.push({
      title: 'Quantity',
      dataIndex: 'quantity',
      key: 'quantity',
    });
    columns.push({
      title: 'Unit',
      dataIndex: 'unit',
      key: 'unit',
      render: (unit: string) => unit || 'pcs',
    } as any);
    columns.push({
      title: 'Total',
      dataIndex: 'total',
      key: 'total',
      render: (total: number, record: InvoiceItem) => {
        const calculated = (record.price || 0) * (record.quantity || 0);
        return `₹${calculated.toFixed(2)}`;
      },
    } as any);

    return columns;
  };

  // Action column for both invoice types
  const actionColumn = {
    title: 'Action',
    key: 'action',
    render: (text: string, record: InvoiceItem) => (
      <Space>
        <Button
          type="primary"
          icon={<EditOutlined />}
          size="small"
          onClick={() => handleEditItem(record)}
        >
          Edit
        </Button>
        <Popconfirm
          title="Are you sure you want to delete this item?"
          onConfirm={() => handleDeleteItem(record.id)}
          okText="Yes"
          cancelText="No"
        >
          <Button type="primary" danger icon={<DeleteOutlined />} size="small">
            Delete
          </Button>
        </Popconfirm>
      </Space>
    ),
  };

  // Add action column to both manufactured and traded columns
  getManufacturedColumns().push(actionColumn);
  getTradedColumns().push(actionColumn);

  const handleSave = async () => {
    try {
      const values = await form.validateFields();
      if (currentInvoice) {
        const updatedInvoice = {
          ...currentInvoice,
          ...values,
          invoiceType: currentInvoice.invoiceType,
          items: currentInvoice.items,
        };
        console.log('Saving invoice:', updatedInvoice);

        // Save to localStorage
        localStorageService.saveItem('invoices', updatedInvoice);

        // Update state
        const updatedInvoices = [...invoices, updatedInvoice];
        setInvoices(updatedInvoices);
        setCurrentInvoice(null);
        setVisible(false);
        form.resetFields();
        message.success('Invoice saved successfully!');
      }
    } catch (error) {
      console.error('Error saving invoice:', error);
      message.error('Failed to save invoice');
    }
  };

  const handleAddInvoice = () => {
    form.resetFields();
    setCurrentInvoice({
      id: Date.now().toString(),
      invoiceNumber: `INV-${Date.now()}`,
      date: new Date().toISOString().split('T')[0],
      customerName: '',
      customerEmail: '',
      billingAddress: '',
      invoiceType: 'manufactured',
      items: [],
      subtotal: 0,
      discountRate: 0,
      discountAmount: 0,
      advancePayment: 0,
      shippingCharges: 0,
      packingCharges: 0,
      total: 0,
      discountType: 'percentage'
    });
    setVisible(true);
  };

  const handleEditInvoice = (invoice: Invoice) => {
    const parsedInvoice = parseInvoiceItems(invoice);
    setEditingInvoice(parsedInvoice);
    setCurrentInvoice(parsedInvoice);
    form.setFieldsValue({
      invoiceNumber: parsedInvoice.invoiceNumber,
      date: parsedInvoice.date,
      customerName: parsedInvoice.customerName,
      customerEmail: parsedInvoice.customerEmail,
      billingAddress: parsedInvoice.billingAddress,
      invoiceType: parsedInvoice.invoiceType,
      discountRate: parsedInvoice.discountRate,
      advancePayment: parsedInvoice.advancePayment,
      shippingCharges: parsedInvoice.shippingCharges,
      packingCharges: parsedInvoice.packingCharges,
      discountType: parsedInvoice.discountType
    });
    setVisible(true);
  };

  const handleDeleteInvoice = (id: string) => {
    Modal.confirm({
      title: 'Are you sure you want to delete this invoice?',
      content: 'This action cannot be undone.',
      okText: 'Yes',
      cancelText: 'No',
      onOk: () => {
        const updatedInvoices = invoices.filter(invoice => invoice.id !== id);
        setInvoices(updatedInvoices);
        localStorageService.deleteItem('invoices', id);
        message.success('Invoice deleted successfully!');
      },
    });
  };

  const handleFinalizeInvoice = (id: string) => {
    Modal.confirm({
      title: 'Are you sure you want to finalize this invoice?',
      content: 'Once finalized, the invoice cannot be edited.',
      okText: 'Yes',
      cancelText: 'No',
      onOk: () => {
        const invoice = invoices.find(inv => inv.id === id);
        if (invoice) {
          const updatedInvoice = { ...invoice, isFinalized: true };
          const updatedInvoices = invoices.map(inv =>
            inv.id === id ? updatedInvoice : inv
          );
          setInvoices(updatedInvoices);
          localStorageService.saveItem('invoices', updatedInvoice);
          message.success('Invoice finalized successfully!');
        }
      },
    });
  };

  const handleViewActionLog = async (invoiceId: string) => {
    try {
      const log = await invoiceService.getActionLog(invoiceId);
      setActionLog(log);
      setSelectedInvoiceId(invoiceId);
      setShowActionLogModal(true);
    } catch (error) {
      console.error('Error fetching action log:', error);
      message.error('Failed to fetch action log');
    }
  };

  const handlePrint = useReactToPrint({
    content: () => componentRef.current,
  });

  const handleExportPDF = async () => {
    if (!componentRef.current) return;

    try {
      const canvas = await html2canvas(componentRef.current);
      const imgData = canvas.toDataURL('image/png');
      const pdf = new jsPDF();
      const imgWidth = 210;
      const pageHeight = 295;
      const imgHeight = (canvas.height * imgWidth) / canvas.width;
      let heightLeft = imgHeight;
      let position = 0;

      pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
      heightLeft -= pageHeight;

      while (heightLeft >= 0) {
        position = heightLeft - imgHeight;
        pdf.addPage();
        pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
        heightLeft -= pageHeight;
      }

      pdf.save(`invoice-${currentInvoice?.invoiceNumber}.pdf`);
    } catch (error) {
      console.error('Error generating PDF:', error);
      message.error('Failed to generate PDF');
    }
  };

  const componentRef = useRef<HTMLDivElement>(null);

  const invoiceColumns = [
    {
      title: 'Invoice Number',
      dataIndex: 'invoiceNumber',
      key: 'invoiceNumber',
    },
    {
      title: 'Date',
      dataIndex: 'date',
      key: 'date',
    },
    {
      title: 'Customer Name',
      dataIndex: 'customerName',
      key: 'customerName',
    },
    {
      title: 'Total',
      dataIndex: 'total',
      key: 'total',
      render: (total: number) => `₹${total.toFixed(2)}`,
    },
    {
      title: 'Status',
      dataIndex: 'isFinalized',
      key: 'isFinalized',
      render: (isFinalized: boolean) => (
        <span style={{ color: isFinalized ? '#52c41a' : '#faad14' }}>
          {isFinalized ? 'Finalized' : 'Draft'}
        </span>
      ),
    },
    {
      title: 'Actions',
      key: 'actions',
      render: (text: string, record: Invoice) => (
        <Space>
          <Button
            type="primary"
            icon={<EditOutlined />}
            onClick={() => handleEditInvoice(record)}
            disabled={record.isFinalized}
          >
            Edit
          </Button>
          <Button
            type="primary"
            icon={<PrinterOutlined />}
            onClick={() => {
              setCurrentInvoice(record);
              setTimeout(() => handlePrint(), 100);
            }}
          >
            Print
          </Button>
          <Button
            type="primary"
            icon={<FilePdfOutlined />}
            onClick={() => {
              setCurrentInvoice(record);
              setTimeout(() => handleExportPDF(), 100);
            }}
          >
            Export PDF
          </Button>
          <Dropdown
            overlay={
              <Menu>
                <Menu.Item
                  key="view-log"
                  icon={<HistoryOutlined />}
                  onClick={() => handleViewActionLog(record.id)}
                >
                  View Action Log
                </Menu.Item>
                {!record.isFinalized && (
                  <Menu.Item
                    key="finalize"
                    icon={<LockOutlined />}
                    onClick={() => handleFinalizeInvoice(record.id)}
                  >
                    Finalize Invoice
                  </Menu.Item>
                )}
              </Menu>
            }
            trigger={['click']}
          >
            <Button icon={<MoreOutlined />} />
          </Dropdown>
          {!record.isFinalized && (
            <Popconfirm
              title="Are you sure you want to delete this invoice?"
              onConfirm={() => handleDeleteInvoice(record.id)}
              okText="Yes"
              cancelText="No"
            >
              <Button type="primary" danger icon={<DeleteOutlined />}>
                Delete
              </Button>
            </Popconfirm>
          )}
        </Space>
      ),
    },
  ];

  return (
    <div style={{ padding: '24px' }}>
      <Card>
        <div style={{ marginBottom: '16px', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
          <h2>Invoice Management</h2>
          <Button type="primary" icon={<PlusOutlined />} onClick={handleAddInvoice}>
            Add Invoice
          </Button>
        </div>
        <Table
          columns={invoiceColumns}
          dataSource={invoices}
          rowKey="id"
          pagination={{
            pageSize: 10,
            showSizeChanger: true,
            pageSizeOptions: ['10', '20', '50', '100'],
          }}
        />
      </Card>

      <Modal
        title={editingInvoice ? 'Edit Invoice' : 'Add Invoice'}
        open={visible}
        onCancel={() => {
          setVisible(false);
          setEditingInvoice(null);
          setCurrentInvoice(null);
          form.resetFields();
        }}
        footer={null}
        width={1200}
      >
        <Form form={form} layout="vertical">
          <Row gutter={16}>
            <Col span={8}>
              <Form.Item
                name="invoiceNumber"
                label="Invoice Number"
                rules={[{ required: true, message: 'Please input invoice number!' }]}
              >
                <Input disabled />
              </Form.Item>
            </Col>
            <Col span={8}>
              <Form.Item
                name="date"
                label="Date"
                rules={[{ required: true, message: 'Please select date!' }]}
              >
                <Input type="date" />
              </Form.Item>
            </Col>
            <Col span={8}>
              <Form.Item
                name="invoiceType"
                label="Invoice Type"
                rules={[{ required: true, message: 'Please select invoice type!' }]}
              >
                <Select>
                  <Option value="manufactured">Manufactured</Option>
                  <Option value="traded">Traded</Option>
                </Select>
              </Form.Item>
            </Col>
          </Row>

          <Row gutter={16}>
            <Col span={12}>
              <Form.Item
                name="customerId"
                label="Customer"
                rules={[{ required: true, message: 'Please select a customer!' }]}
              >
                <Select
                  showSearch
                  placeholder="Search customers by name, email, phone, city or state"
                  optionFilterProp="children"
                  filterOption={(input, option) => {
                    const customer = customers.find(c => c.id === option?.value);
                    if (!customer) return false;

                    const searchText = input.toLowerCase();
                    const customerName = (customer as any).name || customer.customerName || '';
                    const customerEmail = (customer as any).email || customer.mobileNumber1 || '';
                    const customerPhone = (customer as any).phone || customer.mobileNumber2 || '';
                    const customerCity = customer.city || '';
                    const customerState = customer.state || '';

                    return !!(
                      customerName.toLowerCase().includes(searchText) ||
                      customerEmail.toLowerCase().includes(searchText) ||
                      customerPhone.toLowerCase().includes(searchText) ||
                      customerCity.toLowerCase().includes(searchText) ||
                      customerState.toLowerCase().includes(searchText)
                    );
                  }}
                >
                  {customers.map(customer => {
                    const displayName = (customer as any).name || customer.customerName || `Customer ${customer.id}`;

                    return (
                      <Option key={customer.id} value={customer.id}>
                        {displayName}
                      </Option>
                    );
                  })}
                </Select>
              </Form.Item>
            </Col>
            <Col span={12}>
              {/* Customer info fields moved below Add Customer button */}
            </Col>
          </Row>

          <Row gutter={16}>
            <Col span={8}>
              <Form.Item
                name="customerName"
                label="Customer Name"
              >
                <Input />
              </Form.Item>
            </Col>
            <Col span={8}>
              <Form.Item
                name="customerEmail"
                label="Customer Email/Phone"
              >
                <Input />
              </Form.Item>
            </Col>
            <Col span={8}>
              <Form.Item
                name="billingAddress"
                label="Billing Address"
              >
                <Input.TextArea autoSize={{ minRows: 1, maxRows: 3 }} />
              </Form.Item>
            </Col>
          </Row>
          <Row>
            <Col span={24} style={{ textAlign: 'right', marginBottom: '20px' }}>
              <Button
                type="primary"
                onClick={() => {
                  if (selectedCustomer) {
                    // Get the updated values from the form
                    const updatedValues = form.getFieldsValue(['customerName', 'customerEmail', 'billingAddress']);

                    // Parse the billing address to extract individual components
                    // This is a simplified approach - in a real app, you might want a more robust parser
                    const addressParts = updatedValues.billingAddress.split(', ');
                    const houseNumber = addressParts[0] || '';
                    const city = addressParts[1] || '';
                    const district = addressParts[2] || '';
                    const stateAndPin = addressParts[3] || '';

                    // Extract state and pin code
                    const stateParts = stateAndPin.split(' - ');
                    const state = stateParts[0] || '';
                    const pinCode = stateParts[1] || '';

                    // Extract landmark if present
                    const landmarkMatch = updatedValues.billingAddress.match(/\(Landmark: (.+)\)/);
                    const landmark = landmarkMatch ? landmarkMatch[1] : '';

                    // Create the updated customer object
                    const updatedCustomer = {
                      ...selectedCustomer,
                      customerName: updatedValues.customerName,
                      mobileNumber1: updatedValues.customerEmail,
                      houseNumber,
                      city,
                      district,
                      state,
                      pinCode,
                      landmark
                    };

                    // Update customers list
                    const updatedCustomers = customers.map(customer =>
                      customer.id === selectedCustomer.id ? updatedCustomer : customer
                    );

                    // Save to localStorage
                    localStorageService.saveItem('customers', updatedCustomer);
                    setCustomers(updatedCustomers);
                    message.success('Customer updated successfully!');
                  } else {
                    // Add new customer
                    form.validateFields(['customerName', 'customerEmail', 'billingAddress'])
                      .then(values => {
                        handleAddCustomer(values);
                      })
                      .catch(error => {
                        console.log('Validation error:', error);
                        message.error('Please fill in all required customer fields');
                      });
                  }
                }}
              >
                {selectedCustomer ? 'Update Customer' : 'Add Customer'}
              </Button>
            </Col>
          </Row>

          <Divider />

          <div style={{ marginBottom: '16px', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
            <h3>Invoice Items</h3>
            <Button type="primary" icon={<PlusOutlined />} onClick={() => setItemVisible(true)}>
              Add Item
            </Button>
          </div>

          <Table
            columns={currentInvoice?.invoiceType === 'manufactured' ? getManufacturedColumns() : getTradedColumns()}
            dataSource={Array.isArray(currentInvoice?.items) ? currentInvoice.items : []}
            rowKey="id"
            pagination={false}
          />

          <Divider />

          <Row gutter={16}>
            <Col span={8}>
              <Form.Item
                name="discountType"
                label="Discount Type"
              >
                <Select value={discountType} onChange={setDiscountType}>
                  <Option value="percentage">Percentage</Option>
                  <Option value="decimal">Fixed Amount</Option>
                </Select>
              </Form.Item>
            </Col>
            <Col span={8}>
              <Form.Item
                name="discountRate"
                label={discountType === 'percentage' ? 'Discount Rate (%)' : 'Discount Amount'}
              >
                <InputNumber
                  min={0}
                  step={discountType === 'percentage' ? 0.1 : 1}
                  style={{ width: '100%' }}
                  formatter={value => discountType === 'percentage' ? `${value}%` : `₹${value}`}
                  parser={value => {
                    const numStr = String(value || '').replace(/[₹%]/g, '');
                    return Number(numStr) || 0;
                  }}
                />
              </Form.Item>
            </Col>
            <Col span={8}>
              <Form.Item
                name="advancePayment"
                label="Advance Payment"
              >
                <InputNumber
                  min={0}
                  step={0.01}
                  style={{ width: '100%' }}
                  formatter={value => `₹ ${value}`.replace(/\B(?=(\d{3})+(?!\d))/g, ',')}
                  parser={value => Number(String(value || '').replace(/₹\s?|(,*)/g, '')) || 0}
                />
              </Form.Item>
            </Col>
          </Row>

          <Row gutter={16}>
            <Col span={8}>
              <Form.Item
                name="shippingCharges"
                label="Shipping Charges"
              >
                <InputNumber
                  min={0}
                  step={0.01}
                  style={{ width: '100%' }}
                  formatter={value => `₹ ${value}`.replace(/\B(?=(\d{3})+(?!\d))/g, ',')}
                  parser={value => Number(String(value || '').replace(/₹\s?|(,*)/g, '')) || 0}
                />
              </Form.Item>
            </Col>
            <Col span={8}>
              <Form.Item
                name="packingCharges"
                label="Packing Charges"
              >
                <InputNumber
                  min={0}
                  step={0.01}
                  style={{ width: '100%' }}
                  formatter={value => `₹ ${value}`.replace(/\B(?=(\d{3})+(?!\d))/g, ',')}
                  parser={value => Number(String(value || '').replace(/₹\s?|(,*)/g, '')) || 0}
                />
              </Form.Item>
            </Col>
            <Col span={8}>
              <div style={{ textAlign: 'right' }}>
                <p>Subtotal: ₹{currentInvoice?.subtotal?.toFixed(2) || '0.00'}</p>
                <p>Discount: ₹{currentInvoice?.discountAmount?.toFixed(2) || '0.00'}</p>
                <p>Advance: ₹{currentInvoice?.advancePayment?.toFixed(2) || '0.00'}</p>
                <p>Shipping: ₹{currentInvoice?.shippingCharges?.toFixed(2) || '0.00'}</p>
                <p>Packing: ₹{currentInvoice?.packingCharges?.toFixed(2) || '0.00'}</p>
                <h3>Total: ₹{currentInvoice?.total?.toFixed(2) || '0.00'}</h3>
              </div>
            </Col>
          </Row>

          <Row>
            <Col span={24} style={{ textAlign: 'right' }}>
              <Space>
                <Button onClick={() => {
                  setVisible(false);
                  setEditingInvoice(null);
                  setCurrentInvoice(null);
                  form.resetFields();
                }}>
                  Cancel
                </Button>
                <Button type="primary" onClick={handleSave}>
                  {editingInvoice ? 'Update' : 'Save'} Invoice
                </Button>
              </Space>
            </Col>
          </Row>
        </Form>
      </Modal>

      <Modal
        title="Add Item"
        open={itemVisible}
        onCancel={() => {
          setItemVisible(false);
          itemForm.resetFields();
        }}
        footer={null}
        width={800}
      >
        <Form form={itemForm} layout="vertical">
          <Form.Item
            name="productId"
            hidden={true}
          >
            <Input />
          </Form.Item>

          <Form.Item
            name="productIdDisplay"
            label="Product"
            rules={[{ required: true, message: 'Please select or enter a product!' }]}
          >
            <div style={{ display: 'flex', gap: '8px' }}>
              <Select
              placeholder="Select or enter a product"

              showSearch
              optionFilterProp="children"
              filterOption={(input, option) =>
                String(option?.children || '').toLowerCase().includes(input.toLowerCase())
              }
              onChange={(value) => {
                // Check if the value matches an existing product ID
                const selectedProduct = products.find(p => p.id === value);

                if (selectedProduct) {
                  // Update the display field with the product SKU
                  itemForm.setFieldsValue({
                    productIdDisplay: selectedProduct.sku,
                    productId: value
                  });

                  // Use the handleProductSelect function
                  handleProductSelect(value);

                  // Handle product category change
                  handleProductCategoryChange(selectedProduct.category || '');

                  // Auto-populate price based on product
                  if (currentInvoice?.invoiceType === 'manufactured') {
                    // Use inch-based pricing if available (for Laddu Gopal Dress and Base)
                    if (selectedProduct.ratePerInch !== undefined) {
                      itemForm.setFieldsValue({
                        ratePerInch: selectedProduct.ratePerInch
                      });
                    }
                  }

                  // Set the rate field with the product price
                  itemForm.setFieldsValue({
                    rate: selectedProduct.price
                  });
                }
              }}
              >
                {products.map((product) => (
                  <Select.Option key={product.id} value={product.id}>
                    {product.sku}
                  </Select.Option>
                ))}
              </Select>


              <Button
                type="primary"
                icon={<PlusOutlined />}
                onClick={() => {
                  setShowAddProductModal(true);
                }}
              >
                Add New Product
              </Button>
            </div>
          </Form.Item>

          <Form.Item
            name="productCategory"
            hidden={true}
          >
            <Input type="hidden" />
          </Form.Item>


          {showRateField && (
          <Form.Item
            name="rate"
            label="Rate Per Piece"
          >
            <InputNumber
              min={0}
              step={0.01}
              style={{ width: '100%' }}
              formatter={value => `₹ ${value}`.replace(/\B(?=(\d{3})+(?!\d))/g, ',')}
              parser={value => Number(String(value || '').replace(/₹\s?|(,*)/g, '')) || 0 as any}
              placeholder="Enter rate per piece"
              disabled={disableRateField || !!(selectedProductCategory && selectedProductCategory.toLowerCase().includes('base'))}
            />
          </Form.Item>
          )}

          {currentInvoice?.invoiceType === 'manufactured' ? (
            <>
          <Form.Item
            name="ratePerInch"
            label="Rate Per Inch"
          >
            <InputNumber
              min={0}
              step={0.01}
              style={{ width: '100%' }}
              formatter={value => `₹ ${value}`.replace(/\B(?=(\d{3})+(?!\d))/g, ',')}
              parser={value => Number(String(value || '').replace(/₹\s?|(,*)/g, '')) || 0 as any}
              placeholder="Enter rate per inch"
            />
          </Form.Item>

          <Form.Item
            name="size"
            label="Size"
          >
            <InputNumber
              min={0}
              step={0.1}
              style={{ width: '100%' }}
              placeholder="Enter size"
            />
          </Form.Item>
            </>
          ) : null}

          <Form.Item
            name="quantity"
            label="Quantity"
            rules={[{ required: true, message: 'Please input quantity!' }]}
          >
            <InputNumber
              min={1}
              style={{ width: '100%' }}
              placeholder="Enter quantity"
            />
          </Form.Item>

          <Form.Item
            name="unit"
            label="Unit"
          >
            <Select placeholder="Select unit">
              <Option value="pcs">Pieces</Option>
              <Option value="inch">Inches</Option>
              <Option value="feet">Feet</Option>
              <Option value="meter">Meter</Option>
              <Option value="kg">Kilograms</Option>
              <Option value="g">Grams</Option>
              <Option value="l">Liters</Option>
              <Option value="ml">Milliliters</Option>
            </Select>
          </Form.Item>

          <Form.Item>
            <Space>
              <Button type="primary" onClick={handleSaveItem}>
                Add Item
              </Button>
              <Button onClick={() => {
                setItemVisible(false);
                itemForm.resetFields();
              }}>
                Cancel
              </Button>
            </Space>
          </Form.Item>
        </Form>
      </Modal>

      <Modal
        title="Edit Item"
        open={showEditItemModal}
        onCancel={() => {
          setShowEditItemModal(false);
          setEditingItem(null);
          itemForm.resetFields();
        }}
        footer={null}
        width={800}
      >
        <Form form={itemForm} layout="vertical">
          <Form.Item
            name="productId"
            label="Product"
            rules={[{ required: true, message: 'Please select a product!' }]}
          >
            <Select
              placeholder="Select a product"
              showSearch
              optionFilterProp="children"
              filterOption={(input, option) =>
                String(option?.children || '').toLowerCase().includes(input.toLowerCase())
              }
              onChange={(value) => {
                const selectedProduct = products.find(p => p.id === value);
                if (selectedProduct) {
                  handleProductSelect(value);
                  handleProductCategoryChange(selectedProduct.category || '');
                }
              }}
            >
              {products.map((product) => (
                <Select.Option key={product.id} value={product.id}>
                  {product.sku}
                </Select.Option>
              ))}
            </Select>
          </Form.Item>

          {showRateField && (
          <Form.Item
            name="rate"
            label="Rate Per Piece"
          >
            <InputNumber
              min={0}
              step={0.01}
              style={{ width: '100%' }}
              formatter={value => `₹ ${value}`.replace(/\B(?=(\d{3})+(?!\d))/g, ',')}
              parser={value => Number(String(value || '').replace(/₹\s?|(,*)/g, '')) || 0 as any}
              placeholder="Enter rate per piece"
              disabled={disableRateField || !!(selectedProductCategory && selectedProductCategory.toLowerCase().includes('base'))}
            />
          </Form.Item>
          )}

          {currentInvoice?.invoiceType === 'manufactured' ? (
            <>
          <Form.Item
            name="ratePerInch"
            label="Rate Per Inch"
          >
            <InputNumber
              min={0}
              step={0.01}
              style={{ width: '100%' }}
              formatter={value => `₹ ${value}`.replace(/\B(?=(\d{3})+(?!\d))/g, ',')}
              parser={value => Number(String(value || '').replace(/₹\s?|(,*)/g, '')) || 0 as any}
              placeholder="Enter rate per inch"
            />
          </Form.Item>

          <Form.Item
            name="size"
            label="Size"
          >
            <InputNumber
              min={0}
              step={0.1}
              style={{ width: '100%' }}
              placeholder="Enter size"
            />
          </Form.Item>
            </>
          ) : null}

          <Form.Item
            name="quantity"
            label="Quantity"
            rules={[{ required: true, message: 'Please input quantity!' }]}
          >
            <InputNumber
              min={1}
              style={{ width: '100%' }}
              placeholder="Enter quantity"
            />
          </Form.Item>

          <Form.Item
            name="unit"
            label="Unit"
          >
            <Select placeholder="Select unit">
              <Option value="pcs">Pieces</Option>
              <Option value="inch">Inches</Option>
              <Option value="feet">Feet</Option>
              <Option value="meter">Meter</Option>
              <Option value="kg">Kilograms</Option>
              <Option value="g">Grams</Option>
              <Option value="l">Liters</Option>
              <Option value="ml">Milliliters</Option>
            </Select>
          </Form.Item>

          <Form.Item>
            <Space>
              <Button type="primary" onClick={handleUpdateItem}>
                Update Item
              </Button>
              <Button onClick={() => {
                setShowEditItemModal(false);
                setEditingItem(null);
                itemForm.resetFields();
              }}>
                Cancel
              </Button>
            </Space>
          </Form.Item>
        </Form>
      </Modal>

      <Modal
        title="Add New Product"
        open={showAddProductModal}
        onCancel={() => setShowAddProductModal(false)}
        footer={null}
        width={800}
      >
        <ProductFormComponent
          onSave={(product) => {
            // Add the new product to the products list
            setProducts([...products, product]);
            setShowAddProductModal(false);
            message.success('Product added successfully!');
          }}
          onCancel={() => setShowAddProductModal(false)}
        />
      </Modal>

      <Modal
        title="Action Log"
        open={showActionLogModal}
        onCancel={() => {
          setShowActionLogModal(false);
          setSelectedInvoiceId(null);
          setActionLog([]);
        }}
        footer={null}
        width={800}
      >
        <InvoiceActionLog
          invoiceId={selectedInvoiceId || ''}
          onClose={() => {
            setShowActionLogModal(false);
            setSelectedInvoiceId(null);
            setActionLog([]);
          }}
        />
      </Modal>

      {currentInvoice && (
        <div style={{ display: 'none' }}>
          <div ref={componentRef} style={{ padding: '20px' }}>
            <h2 style={{ textAlign: 'center' }}>Invoice</h2>
            <p>Invoice Number: {currentInvoice.invoiceNumber}</p>
            <p>Date: {currentInvoice.date}</p>
            <p>Customer Name: {currentInvoice.customerName}</p>
            <p>Billing Address: {currentInvoice.billingAddress}</p>

            <Table
              columns={currentInvoice.invoiceType === 'manufactured' ? getManufacturedColumns() : getTradedColumns()}
              dataSource={Array.isArray(currentInvoice.items) ? currentInvoice.items : []}
              rowKey="id"
              pagination={false}
            />

            <div style={{ textAlign: 'right', marginTop: '20px' }}>
              <p>Subtotal: ₹{currentInvoice.subtotal.toFixed(2)}</p>
              <p>Discount: ₹{currentInvoice.discountAmount.toFixed(2)}</p>
              <p>Advance: ₹{currentInvoice.advancePayment.toFixed(2)}</p>
              <p>Shipping: ₹{currentInvoice.shippingCharges.toFixed(2)}</p>
              <p>Packing: ₹{currentInvoice.packingCharges.toFixed(2)}</p>
              <h3>Total: ₹{currentInvoice.total.toFixed(2)}</h3>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default InvoiceScreen;
