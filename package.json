{
  "name": "erpsoul-refactored",
  "private": true,
  "workspaces": [
    "apps/client",
    "apps/server",
    "apps/packages/shared"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "start": "node apps/server/dist/index.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev --workspace=apps/client\"",
    "dev:server": "node apps/server/src/simple-server.js",
    "dev:sqlite": "concurrently \"npm run dev:sqlite-server\" \"npm run dev --workspace=apps/client\"",
    "dev:sqlite-server": "node apps/server/src/sqlite-server.js",
    "dev:sqlite3": "concurrently \"npm run dev:sqlite3-server\" \"npm run dev --workspace=apps/client\"",
    "dev:sqlite3-server": "node apps/server/src/sqlite3-server.js"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.16",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@ant-design/plots": "^2.6.5",
    "antd": "^5.27.2",
    "lucide-react": "^0.542.0",
    "papaparse": "^5.5.3",
    "react-to-print": "^3.1.1",
    "sqlite3": "^5.1.7",
    "xlsx": "^0.18.5"
  }
}
